# Web staging client configuration. Copy to .env.staging (git-ignored).
# Use only publishable/public values here. Server secrets belong in Supabase.
VITE_SUPABASE_URL=https://your-staging-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-publishable-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_VAPID_PUBLIC_KEY=

# Use separate staging projects/keys so test telemetry never mixes with production.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
